import { db, nowISO, uid } from "./db";\nimport { hashPassword, randomSalt } from "./auth";\nimport type {\n  ActivityEntry,\n  Agreement,\n  AppNotification,\n  Client,\n  DocTemplate,\n  LegalDocument,\n  LegalEvent,\n  LibraryItem,\n  Matter,\n  MatterNote,\n  MatterType,\n  Payment,\n  PortfolioContent,\n  Settings,\n  Task,\n  User,\n} from "./types";\n\n/* =============================================================\n                                                                              \n   ============================================================= */\n\nconst DAY = 86_400_000;\nconst d = (offsetDays: number, hour = 9, minute = 0) => {\n  const date = new Date(Date.now() + offsetDays * DAY);\n  date.setHours(hour, minute, 0, 0);\n  return date.toISOString();\n};\n\nexport const DEMO_ACCOUNTS = [\n  { username: "admin", password: "Admin@2025", role: "admin" as const, name: "                                                  " },\n  { username: "sara", password: "Admin@2025", role: "partner" as const, name: "  .                                           " },\n  { username: "fahad", password: "Admin@2025", role: "senior" as const, name: "                                           " },\n  { username: "noura", password: "Admin@2025", role: "associate" as const, name: "                                                     " },\n  { username: "layan", password: "Admin@2025", role: "paralegal" as const, name: "  .                               " },\n];\n\nasync function buildUsers(): Promise<User[]> {\n  const out: User[] = [];\n  const base = [\n    {\n      name: "                                                  ",\n      username: "admin",\n      role: "admin" as const,\n      title: "                                                          ",\n      email: "khaled@almansour-law.sa",\n      phone: "+966 55 123 4567",\n      color: "#B08419",\n      bio: "                                                                  22                                                                                                                                .",\n    },\n    {\n      name: "  .                                           ",\n      username: "sara",\n      role: "partner" as const,\n      title: "                                                                    ",\n      email: "sara@almansour-law.sa",\n      phone: "+966 50 987 6543",\n      color: "#2563C9",\n      bio: "                                                                                                                        .",\n    },\n    {\n      name: "                                           ",\n      username: "fahad",\n      role: "senior" as const,\n      title: "                                                      ",\n      email: "fahad@almansour-law.sa",\n      phone: "+966 53 222 1100",\n      color: "#0F8A5F",\n      bio: "                                                                                       .",\n    },\n    {\n      name: "                                                     ",\n      username: "noura",\n      role: "associate" as const,\n      title: "                                      ",\n      email: "noura@almansour-law.sa",\n      phone: "+966 56 777 3344",\n      color: "#7C3AED",\n      bio: "                                                                                .",\n    },\n    {\n      name: "  .                               ",\n      username: "layan",\n      role: "paralegal" as const,\n      title: "                                                         ",\n      email: "layan@almansour-law.sa",\n      phone: "+966 54 313 9090",\n      color: "#0E7490",\n      bio: "                                                                                                         .",\n    },\n    {\n      name: "  .                               ",\n      username: "omar",\n      role: "consultant" as const,\n      title: "                                          ",\n      email: "omar@almansour-law.sa",\n      phone: "+966 55 909 1212",\n      color: "#B45309",\n      bio: "                                                                                          .",\n    },\n  ];\n  for (const u of base) {\n    const salt = randomSalt();\n    const password = DEMO_ACCOUNTS.find((a) => a.username === u.username)?.password ?? "Admin@2025";\n    out.push({\n      id: uid("usr_"),\n      name: u.name,\n      username: u.username,\n      email: u.email,\n      phone: u.phone,\n      role: u.role,\n      title: u.title,\n      bio: u.bio,\n      avatarColor: u.color,\n      salt,\n      passwordHash: await hashPassword(password, salt),\n      isActive: true,\n      createdAt: d(-540),\n      lastLoginAt: d(-1, 8, 30),\n      notificationsEnabled: true,\n    });\n  }\n  return out;\n}\n\nconst MATTER_TYPES: MatterType[] = [\n  { id: "mt_commercial", name: "                       ", color: "#2563C9", icon: "building-2", description: "                                                                                                 " },\n  { id: "mt_labor", name: "          ", color: "#B08419", icon: "hard-hat", description: "                                                                               " },\n  { id: "mt_civil", name: "        ", color: "#0F8A5F", icon: "scale", description: "                                      " },\n  { id: "mt_criminal", name: "          ", color: "#C02B3A", icon: "gavel", description: "                                  " },\n  { id: "mt_family", name: "                     ", color: "#7C3AED", icon: "heart", description: "                                             " },\n  { id: "mt_ip", name: "                     ", color: "#0E7490", icon: "lightbulb", description: "                                                   " },\n  { id: "mt_realestate", name: "          ", color: "#B45309", icon: "home", description: "                                    " },\n  { id: "mt_arbitration", name: "          ", color: "#64748B", icon: "scale", description: "                                " },\n  { id: "mt_tax", name: "          ", color: "#7C2D12", icon: "calculator", description: "                                      " },\n  { id: "mt_contracts", name: "        ", color: "#1E40AF", icon: "file-signature", description: "                                               " },\n];\n\nconst CLIENTS: Client[] = [\n  {\n    id: "cl_horizon",\n    name: "                                                   ",\n    legalName: "                                                                    ",\n    type: "company",\n    commercialId: "1010234567",\n    phone: "+966 11 456 7890",\n    email: "legal@horizon-construction.sa",\n    address: "                                                                  18",\n    city: "            ",\n    profession: "                                        ",\n    notes: "                                                                             .                                                           .",\n    tags: ["                  ", "              ", "          "],\n    priority: "vip",\n    assignedTo: "USR_ADMIN",\n    status: "active",\n    createdAt: d(-420),\n    updatedAt: nowISO(),\n      } as any;\n\n  const notifications: AppNotification[] = [\n    { id: "nf_001", title: "                   ", body: "                                                                              ", kind: "deadline", refType: "event", refId: "ev_003", read: false, at: d(0, 7, 30), link: "/calendar" },\n    { id: "nf_002", title: "                   ", body: "                                                                   ", kind: "task", refType: "task", refId: "tk_003", read: false, at: d(0, 7, 35), link: "/tasks" },\n    { id: "nf_003", title: "                     ", body: "                                                                          9:30", kind: "deadline", refType: "event", refId: "ev_001", read: false, at: d(0, 7, 40), link: "/calendar" },\n    { id: "nf_004", title: "                     ", body: "                                                               ", kind: "payment", refType: "event", refId: "ev_006", read: true, at: d(-1, 9, 0), link: "/matters/ma_2401" },\n  ];\n\n  const activity: ActivityEntry[] = [\n    { id: "ac_001", userId: adminId, userName: "                                                  ", action: "          ", entity: "        ", entityId: "ma_2401", meta: "                                      ", at: d(0, 8, 42) },\n    { id: "ac_002", userId: paraId, userName: "  .                               ", action: "          ", entity: "          ", entityId: "doc_009", meta: "                                               ", at: d(0, 8, 15) },\n    { id: "ac_003", userId: assocId, userName: "                                                     ", action: "          ", entity: "          ", entityId: "nt_006", meta: "                                                               ", at: d(0, 8, 20) },\n    { id: "ac_004", userId: adminId, userName: "                                                  ", action: "          ", entity: "          ", entityId: "doc_007", meta: "                                                              2", at: d(0, 8, 45) },\n    { id: "ac_005", userId: partnerId, userName: "  .                                           ", action: "          ", entity: "          ", entityId: "lb_006", meta: "                                            ", at: d(-1, 13, 0) },\n    { id: "ac_006", userId: seniorId, userName: "                                           ", action: "          ", entity: "        ", entityId: "ma_2402", meta: "                                  ", at: d(-2, 11, 10) },\n  ];\n\n  await db.transaction(\n    "rw",\n    [\n      db.users,\n      db.clients,\n      db.matterTypes,\n      db.matters,